# Copy to .env (gitignored). Values come from Splunk / your secret store.
# Never commit a real token.

SPLUNK_HEC_URL=https://localhost:8088/services/collector/event
SPLUNK_HEC_TOKEN=
SPLUNK_HEC_INSECURE=0
# Collector-side HMAC pepper for employee numbers / badge PANs. Not used by sample JSON (already opaque worker_id).
FLO_PII_PEPPER=
