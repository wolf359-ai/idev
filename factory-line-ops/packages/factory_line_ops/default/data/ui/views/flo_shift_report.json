{
  "title": "Shift report",
  "description": "Attendance, output, and downtime for one shift_id after or during the shift.",
  "inputs": {
    "input_site": {
      "type": "input.dropdown",
      "title": "Factory",
      "options": {
        "token": "tok_site",
        "selectFirstSearchResult": true
      },
      "dataSources": {
        "primary": "ds_sites"
      }
    },
    "input_shift": {
      "type": "input.text",
      "title": "Shift id",
      "options": {
        "token": "tok_shift"
      }
    }
  },
  "dataSources": {
    "ds_sites": {
      "type": "ds.search",
      "options": {
        "query": "| inputlookup flo_kv_sites | table site_id, site_name | rename site_id as value, site_name as label"
      }
    },
    "ds_shift": {
      "type": "ds.search",
      "options": {
        "query": "| inputlookup flo_current_shift_snapshot where site=\"$tok_site$\"\n| search shift_id=\"$tok_shift$\"\n| stats sum(headcount_actual) as clocked, sum(headcount_plan) as planned, sum(good_count_shift) as good_count, sum(downtime_minutes_shift) as downtime_minutes by shift_id"
      }
    },
    "ds_downtime": {
      "type": "ds.search",
      "options": {
        "query": "`factory_ops_indexes` sourcetype=factory:line:downtime site=\"$tok_site$\" shift_id=\"$tok_shift$\"\n| stats sum(downtime_minutes) as minutes by downtime_reason\n| sort -minutes"
      }
    }
  },
  "visualizations": {
    "viz_shift": {
      "type": "splunk.table",
      "title": "Shift totals",
      "dataSources": {
        "primary": "ds_shift"
      }
    },
    "viz_downtime": {
      "type": "splunk.bar",
      "title": "Downtime reasons",
      "dataSources": {
        "primary": "ds_downtime"
      }
    }
  },
  "layout": {
    "type": "grid",
    "globalInputs": ["input_site", "input_shift"],
    "layoutDefinitions": {
      "layout_1": {
        "type": "grid",
        "structure": [
          { "item": "viz_shift", "position": { "x": 0, "y": 0, "w": 12, "h": 3 } },
          { "item": "viz_downtime", "position": { "x": 0, "y": 3, "w": 12, "h": 5 } }
        ]
      }
    },
    "tabs": {
      "items": [
        {
          "layoutId": "layout_1",
          "label": "Shift"
        }
      ]
    },
    "options": {
      "submitButton": true,
      "showTitleAndDescription": true
    }
  }
}
